<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Sadaf Shipping & Logistics </title>
</head>

<body>

    <body>
        <div class="dashboard">
            <div class="header">
                <div class="logo">Sadaf Shipping & Logistics</div>
                <div class="user-info">
                    <span>Welcome back, Rafeeq </span>
                    <div class="avatar">R</div>
                </div>
            </div>
            <div class="navigation">
                <button class="nav-button active-nav">Dashboard</button>
                <form action="/dsr">
                    <button id="dsr-nav" class="nav-button">DSR</button>
                </form>
                <form action="/expenditure">
                    <button id="exp-nav" class="nav-button">Expenditure</button>
                </form>
                <button class="nav-button">Reports</button>
                <button class="nav-button">Settings</button>
            </div>

            <div class="cards-container">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Daily Sales Report</div>
                        <div class="icon dsr-icon">DSR</div>
                    </div>
                    <div class="card-content">₹ <%=totalsum %>
                    </div>
                    <div class="card-footer">
                        <span class="positive">↑ 12% </span>from last week
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Expenditure</div>
                        <div class="icon exp-icon">EXP</div>
                    </div>
                    <div class="card-content">₹1,850</div>
                    <div class="card-footer">
                        <span class="negative">↑ 8% </span>from last month
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Net Profit</div>
                        <div class="icon stat-icon">PRF</div>
                    </div>
                    <div class="card-content">₹3,390</div>
                    <div class="card-footer">
                        <span class="positive">↑ 15% </span>from last week
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Budget Status</div>
                        <div class="icon report-icon">BDG</div>
                    </div>
                    <div class="card-content">74%</div>
                    <div class="card-footer">
                        <span class="positive">↓ 3% </span>in spending
                    </div>
                </div>
            </div>

            <div class="main-features">
                <div class="chart-container">
                    <div class="chart-header">
                        <div class="chart-title">Financial Overview</div>
                        <div class="chart-tabs">
                            <div class="chart-tab active-tab">Weekly</div>
                            <div class="chart-tab inactive-tab">Monthly</div>
                            <div class="chart-tab inactive-tab">Yearly</div>
                        </div>
                    </div>
                    <div class="chart-placeholder">Chart visualization would appear here -- Under Development </div>
                </div>

                <div class="recent-activity">
                    <div class="activity-title">Recent Activity</div>
                    <div class="activity-list">
                        <div class="activity-item">
                            <div class="activity-info">
                                <div class="activity-name">Office Supplies</div>
                                <div class="activity-date">Today, 10:30 AM</div>
                            </div>
                            <div class="activity-amount expense">-₹120.50</div>
                        </div>

                        <div class="activity-item">
                            <div class="activity-info">
                                <div class="activity-name">Client Payment</div>
                                <div class="activity-date">Today, 9:15 AM</div>
                            </div>
                            <div class="activity-amount income">+₹2,500.00</div>
                        </div>

                        <div class="activity-item">
                            <div class="activity-info">
                                <div class="activity-name">Marketing</div>
                                <div class="activity-date">Yesterday</div>
                            </div>
                            <div class="activity-amount expense">-₹350.00</div>
                        </div>

                        <div class="activity-item">
                            <div class="activity-info">
                                <div class="activity-name">Product Sales</div>
                                <div class="activity-date">Yesterday</div>
                            </div>
                            <div class="activity-amount income">+₹1,200.00</div>
                        </div>

                        <div class="activity-item">
                            <div class="activity-info">
                                <div class="activity-name">Utilities</div>
                                <div class="activity-date">Mar 06, 2025</div>
                            </div>
                            <div class="activity-amount expense">-₹ 95.40</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="/index.js"></script>
    </body>

</html>